NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# URL com pool do Neon, usada pela aplicação em runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=verify-full

# URL direta do Neon, recomendada para executar migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=verify-full

# Gere com: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
